# =============================================================================
# .env.migration — conexión a PRODUCCIÓN para el pipeline de re-migración legacy
#
# Este archivo NO se commitea (.gitignore:64). Contiene la password de la base
# de Supabase: tratalo como una credencial, no como configuración.
#
# Lo leen: migration/preflight.sql, migration/clean_demo_seed.sql,
#          migration/migrate.py (acepta PG_DSN directo, ver migrate.py:83),
#          migration/restore_datos_erp.sql y migration/run_real.sh.
#
# Uso:  set -a; . ./.env.migration; set +a
# =============================================================================

# -----------------------------------------------------------------------------
# PG_DSN — string de conexión a la base de producción.  ← COMPLETAR
#
# Dónde sacarlo: Supabase dashboard -> Project Settings -> Database ->
# Connection string -> pestaña "Session pooler" (URI).
#
# TIENE QUE SER EL SESSION POOLER, PUERTO 5432.
#   Session pooler   :5432  -> SÍ. Es el que se usó en la migración de julio.
#   Direct connection:5432  -> sirve sólo si tu red tiene IPv6.
#   Transaction pooler:6543 -> NO. No mantiene estado de sesión entre statements,
#                              y acá se corren transacciones largas (~240k filas)
#                              donde el snapshot, el TRUNCATE y la migración
#                              dependen de ser una sola unidad. Con 6543 se
#                              rompe a mitad, con la base a medio truncar.
#
# Si la password tiene caracteres especiales (@ / # ? : espacio), van
# percent-encoded dentro de la URI o el parser corta mal el host:
#   @ -> %40   / -> %2F   # -> %23   ? -> %3F   : -> %3A
#
# Formato esperado (reemplazar <PASSWORD>; el resto ya es el de este proyecto):
# PG_DSN=postgresql://postgres.qtlfabajjvhyluqkvike:<PASSWORD>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
# NOTA 2026-08-18: acá estaba la CONEXIÓN DIRECTA (db.<ref>.supabase.co).
# Funciona desde la Mac, pero NO desde Docker: resuelve sólo a IPv6 y el
# bridge de Docker no tiene IPv6 -> 'Network is unreachable'. Como migrate.py
# y pg_dump corren en contenedores, se usa el SESSION POOLER, que es IPv4 y
# funciona desde los dos lados. Verificado contra prod.
PG_DSN=

# -----------------------------------------------------------------------------
# MIGRATION_USER_ID — uuid de auth.users que queda como autor de las filas que
# el legacy no atribuye a nadie (movimientos_fondos.usuario_id y
# ventas.usuario_id son NOT NULL, y el sistema viejo no guardaba quién cargó
# cada registro). Ver migrate.py:61-65.
#
# Éste es el que se usó en la migración del 2026-07-24 (diego@diegoram.me).
# Si la base se recreó y el usuario cambió de uuid, corregilo:
#   psql "$PG_DSN" -tAc "select id, email from auth.users order by created_at;"
MIGRATION_USER_ID=2d880f86-4e26-4e32-99e8-6f813d3cf4b8

# -----------------------------------------------------------------------------
# Origen: MariaDB con el dump legacy cargado. Los defaults de migrate.py
# (SRC_HOST=atgq-migra-mysql, SRC_USER=root, SRC_PASS=migra, SRC_DB=legacy)
# ya coinciden con el contenedor levantado por migration/README.md paso 1,
# así que normalmente no hace falta tocar nada acá.
#
# Dump cargado actualmente:
#   ~/Downloads/backup_sociosonline_atygq_2026-08-17_19-04-08.sql
# SRC_HOST=atgq-migra-mysql
# SRC_DB=legacy
